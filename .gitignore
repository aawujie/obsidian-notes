############################
# Obsidian - 必须忽略（强烈推荐）
############################

# 工作区状态（窗口/当前文件/布局，多设备必冲突）
.obsidian/workspace
.obsidian/workspace.json

# 缓存文件（无价值，可再生）
.obsidian/cache/
.obsidian/index.db
.obsidian/index.db-shm
.obsidian/index.db-wal

############################
# Obsidian - 可选忽略
############################

# 同步/发布相关（你不用官方 Sync/Publish 可忽略）
.obsidian/graph.json
.obsidian/appearance.json

# 插件缓存（每台机器各自维护，同步只会制造冲突）
.obsidian/plugins/recent-files-obsidian/data.json
.obsidian/plugins/obsidian-reminder-plugin/data.json
.obsidian/plugins/obsidian-weread-plugin/data.json
.obsidian/plugins/obsidian-git/data.json

############################
# 系统垃圾
############################

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

############################
# 编辑器/临时文件
############################

*.tmp
*.temp
*.bak
*.swp
*.swo

############################
# 日志
############################

*.log


############################
# Claude 工作树（隔离开发环境，不应被主仓库追踪）
############################

.claude/worktrees/

############################
# Agent Skill 工具（npx skills add 安装，各机器独立）
############################

.agents/

############################
# 大文件（PDF/EPUB）
############################

*.pdf
*.epub

############################
# Python 虚拟环境
############################

.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
uv.lock

# Skills CLI lock 文件（npx skills add 生成，各机器独立）
skills-lock.json

# 自动生成的 Changelog（vault backup 产物，多设备必冲突）
Changelog.md
